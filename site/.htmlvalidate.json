{
  "extends": [
    "html-validate:recommended",
    "html-validate:document"
  ],
  "rules": {
    "no-inline-style": "error",
    "require-sri": [
      "error",
      {
        "target": "all",
        "exclude": ["https://challenges.cloudflare.com/turnstile/v0/api.js"]
      }
    ],
    "no-trailing-whitespace": "off",
    "long-title": "off",
    "void-style": "off",
    "doctype-style": "off"
  }
}
