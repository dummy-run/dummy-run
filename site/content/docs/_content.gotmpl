{{/* Build the reference pages from the repository's own Markdown, so there is one source of truth. */}}
{{ $pages := slice
  (dict "src" "repo/docs/ARCHITECTURE.md" "path" "architecture" "group" "understand" "weight" 10 "summary" "Adapters, the evidence pipeline, browsers and data residency")
  (dict "src" "repo/docs/TELEMETRY.md" "path" "telemetry" "group" "understand" "weight" 12 "summary" "How runs map to OpenTelemetry traces, metrics, logs and Grafana annotations")
  (dict "src" "repo/docs/integrations/grafana.md" "path" "grafana-guide" "title" "Grafana guide" "group" "integrate" "weight" 21 "summary" "Wire runs into Grafana, Tempo, Loki and your own app's traces")
  (dict "src" "repo/docs/PLAN.md" "path" "plan" "group" "project" "weight" 30 "summary" "What ships, in what order")
  (dict "src" "repo/CONTRIBUTING.md" "path" "contributing" "group" "project" "weight" 31 "summary" "How to contribute, the automated checks, and the rules on evidence and privacy")
  (dict "src" "repo/docs/STYLE.md" "path" "style" "group" "project" "weight" 32 "summary" "How we write and cite")
  (dict "src" "repo/docs/TYPOGRAPHY.md" "path" "typography" "group" "project" "weight" 33 "summary" "Body text at 17px, nothing read below 15px and headings that scale with the viewport")
  (dict "src" "repo/brand/README.md" "path" "brand" "group" "project" "weight" 34 "summary" "The logo, mascot and colours")
  (dict "src" "repo/docs/NAMING.md" "path" "naming" "group" "project" "weight" 35 "summary" "Why the project is called Dummy Run, and the cautions on the mascot")
  (dict "src" "repo/docs/LICENSING.md" "path" "licensing" "group" "policy" "weight" 40 "summary" "What the Apache-2.0 licence lets you do")
  (dict "src" "repo/TRADEMARKS.md" "path" "trademarks" "group" "policy" "weight" 41 "summary" "What you may do with the name and logo")
  (dict "src" "repo/SECURITY.md" "path" "security" "group" "policy" "weight" 42 "summary" "Reporting a vulnerability, and findings about apps you do not own")
}}
{{ range $pages }}
  {{ $p := . }}
  {{ with resources.Get .src }}
    {{ $text := .Content }}
    {{ $m := findRESubmatch `(?m)\A# (.+)\n` $text 1 }}
    {{ $title := "" }}
    {{ with $m }}{{ $title = index (index . 0) 1 }}{{ end }}
    {{ with $p.title }}{{ $title = . }}{{ end }}
    {{ if not $title }}{{ errorf "No H1 in %s" $p.src }}{{ end }}
    {{ $body := replaceRE `(?m)\A# .+\n` "" $text 1 }}
    {{ $srcdir := path.Dir (strings.TrimPrefix "repo/" $p.src) }}
    {{ $.AddPage (dict
      "path" $p.path
      "title" $title
      "kind" "page"
      "weight" $p.weight
      "summary" $p.summary
      "params" (dict "group" $p.group "source" (strings.TrimPrefix "repo/" $p.src) "sourcedir" $srcdir "from_repo" true)
      "content" (dict "mediaType" "text/markdown" "value" $body)
    ) }}
  {{ end }}
{{ end }}
