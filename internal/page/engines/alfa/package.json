    "@siteimprove/alfa-device": "0.120.0",
    "@siteimprove/alfa-dom": "0.120.0",
    "@siteimprove/alfa-http": "0.120.0",
    "@siteimprove/alfa-rules": "0.120.0",
    "@siteimprove/alfa-web": "0.120.0",
    "esbuild": "0.25.11"
  }
}
