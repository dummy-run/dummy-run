{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dummyrun.dev/schema/run-record/v1.json",
  "title": "Dummy Run run record",
  "description": "One persona working through one scenario against one preview. Written by the runner, completed by the reviewer.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "started_at", "ended_at", "persona", "scenario", "target", "provider", "browser", "outcome", "steps", "findings", "usage"],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}-[a-z0-9-]+$", "description": "Run ID: date, then a slug" },
    "batch": { "type": "string", "description": "Optional ID grouping runs started together" },
    "started_at": { "type": "string", "format": "date-time" },
    "ended_at": { "type": "string", "format": "date-time" },
    "persona": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "role", "device"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "role": { "type": "string", "description": "The app role the persona signs in with" },
        "device": { "enum": ["desktop", "tablet", "phone"], "description": "The device the run used. A scenario can set its own, which replaces the persona's" },
        "zoom": { "type": "integer", "minimum": 100, "maximum": 500, "description": "Page zoom in percent the run used. Left out means 100" }
      }
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "title": { "type": "string" }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapter", "environment", "base_url"],
      "properties": {
        "adapter": { "type": "string", "description": "Target adapter name, such as url or github-deployments" },
        "environment": { "type": "string", "description": "Preview ID, such as pr-42" },
        "base_url": { "type": "string", "format": "uri" },
        "commit": { "type": "string", "pattern": "^[0-9a-f]{7,40}$" }
      }
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "model", "region"],
      "properties": {
        "kind": { "type": "string", "description": "vertex-gemini, gemini-api, anthropic, openai-compatible, azure-foundry, bedrock" },
        "model": { "type": "string" },
        "region": { "type": "string", "description": "Region the model ran in, or global" }
      }
    },
    "browser": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "enum": ["chrome", "firefox"] },
        "version": { "type": "string" }
      }
    },
    "outcome": {
      "enum": ["completed", "blocked", "errored", "budget_exhausted"],
      "description": "completed: the persona finished its job. blocked: the app stopped it. errored: the harness failed. budget_exhausted: it ran out of steps or tokens"
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["n", "at", "action", "duration_ms"],
        "properties": {
          "n": { "type": "integer", "minimum": 1 },
          "at": { "type": "string", "format": "date-time" },
          "action": { "enum": ["look", "visit", "click", "fill", "type", "select", "press", "back", "scroll", "wait", "a11y", "screenshot", "finish"] },
          "target": { "type": "string", "description": "Selector, label or URL the action used" },
          "url": { "type": "string", "description": "Page URL after the action" },
          "status": { "type": "integer", "description": "HTTP status of the page after the action" },
          "duration_ms": { "type": "integer", "minimum": 0 },
          "screenshot": { "type": "string", "description": "Path relative to the run record" },
          "console_errors": { "type": "integer", "minimum": 0 },
          "a11y_violations": { "type": "integer", "minimum": 0 },
          "note": { "type": "string", "description": "What the persona said about this step" }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "severity", "title", "steps", "evidence", "verdict"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$", "description": "Stable fingerprint, the same across runs that hit the same problem" },
          "kind": { "enum": ["bug", "permission", "friction", "accessibility", "question"] },
          "severity": { "enum": ["blocker", "major", "minor", "info"] },
          "title": { "type": "string" },
          "steps": { "type": "array", "items": { "type": "integer", "minimum": 1 }, "minItems": 1 },
          "evidence": { "enum": ["measured", "code", "sourced", "inferred"] },
          "verdict": { "enum": ["confirmed", "rejected", "pending"], "description": "The reviewer's verdict" }
        }
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_calls", "input_tokens", "output_tokens"],
      "properties": {
        "model_calls": { "type": "integer", "minimum": 0 },
        "input_tokens": { "type": "integer", "minimum": 0 },
        "output_tokens": { "type": "integer", "minimum": 0 },
        "cached_input_tokens": { "type": "integer", "minimum": 0, "description": "Part of input_tokens the service served from its prompt cache, where it reports that" },
        "cost_usd": { "type": "number", "minimum": 0 }
      }
    }
  }
}
