{
  "uid": "dummyrun-personas",
  "title": "Dummy Run: personas",
  "description": "One row per persona. Each row shows the persona's runs, what it found, where it was slow and its traces.",
  "tags": [
    "dummyrun"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "time": {
    "from": "now-14d",
    "to": "now"
  },
  "fiscalYearStartMonth": 0,
  "refresh": "",
  "schemaVersion": 42,
  "panels": [
    {
      "type": "row",
      "collapsed": false,
      "title": "$persona",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "panels": [],
      "repeat": "persona"
    },
    {
      "type": "stat",
      "id": 2,
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(dummyrun_runs_total{dummyrun_target_environment=~\"$environment\", dummyrun_persona_id=~\"$persona\", dummyrun_scenario_id=~\"$scenario\"}[$__range]))",
          "instant": true,
          "legendFormat": "",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Runs",
      "description": "Runs by this persona that ended in the time range.",
      "transparent": false,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "repeatDirection": "h",
      "options": {
        "graphMode": "none",
        "colorMode": "value",
        "justifyMode": "auto",
        "textMode": "value",
        "wideLayout": true,
        "showPercentChange": false,
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "percentChangeColorMode": "standard",
        "orientation": ""
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "#f3f1ec"
              }
            ]
          },
          "noValue": "0"
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "id": 3,
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(dummyrun_runs_total{dummyrun_target_environment=~\"$environment\", dummyrun_persona_id=~\"$persona\", dummyrun_scenario_id=~\"$scenario\", dummyrun_outcome=\"completed\"}[$__range])) / sum(increase(dummyrun_runs_total{dummyrun_target_environment=~\"$environment\", dummyrun_persona_id=~\"$persona\", dummyrun_scenario_id=~\"$scenario\"}[$__range]))",
          "instant": true,
          "legendFormat": "",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Pass rate",
      "description": "Share of this persona's runs where it finished its job.",
      "transparent": false,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 1
      },
      "repeatDirection": "h",
      "options": {
        "graphMode": "none",
        "colorMode": "value",
        "justifyMode": "auto",
        "textMode": "value",
        "wideLayout": true,
        "showPercentChange": false,
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "percentChangeColorMode": "standard",
        "orientation": ""
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "#ff7b72"
              },
              {
                "value": 0.8,
                "color": "#fbad18"
              },
              {
                "value": 0.9,
                "color": "#57d273"
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "id": 4,
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(dummyrun_findings_total{dummyrun_target_environment=~\"$environment\", dummyrun_persona_id=~\"$persona\", dummyrun_verdict=\"confirmed\"}[$__range]))",
          "instant": true,
          "legendFormat": "",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Findings",
      "description": "Findings this persona surfaced that the reviewer confirmed.",
      "transparent": false,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 1
      },
      "repeatDirection": "h",
      "options": {
        "graphMode": "none",
        "colorMode": "value",
        "justifyMode": "auto",
        "textMode": "value",
        "wideLayout": true,
        "showPercentChange": false,
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "percentChangeColorMode": "standard",
        "orientation": ""
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "#f3f1ec"
              },
              {
                "value": 1,
                "color": "#fbad18"
              }
            ]
          },
          "noValue": "0"
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "id": 5,
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(dummyrun_findings_total{dummyrun_target_environment=~\"$environment\", dummyrun_persona_id=~\"$persona\", dummyrun_severity=\"blocker\", dummyrun_verdict=\"confirmed\"}[$__range]))",
          "instant": true,
          "legendFormat": "",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Blockers",
      "description": "Confirmed blocker findings from this persona.",
      "transparent": false,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 1
      },
      "repeatDirection": "h",
      "options": {
        "graphMode": "none",
        "colorMode": "value",
        "justifyMode": "auto",
        "textMode": "value",
        "wideLayout": true,
        "showPercentChange": false,
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "percentChangeColorMode": "standard",
        "orientation": ""
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "#57d273"
              },
              {
                "value": 1,
                "color": "#ff7b72"
              }
            ]
          },
          "noValue": "0"
        },
        "overrides": []
      }
    },
    {
      "type": "table",
      "id": 6,
      "targets": [
        {
          "expr": "{service_name=\"dummyrun\"} | dummyrun_outcome != \"\" | dummyrun_persona_id=~\"$persona\"",
          "maxLines": 1,
          "range": true,
          "refId": "A",
          "queryType": "range",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        }
      ],
      "title": "Role, device, browser and model",
      "description": "From the persona's latest run end log line.",
      "transparent": false,
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 16,
        "y": 1
      },
      "repeatDirection": "h",
      "transformations": [
        {
          "id": "extractFields",
          "options": {
            "format": "auto",
            "keepTime": false,
            "replace": false,
            "source": "labels"
          }
        },
        {
          "id": "organize",
          "options": {
            "includeByName": {
              "browser_name": true,
              "dummyrun_persona_device": true,
              "dummyrun_persona_role": true,
              "gen_ai_request_model": true
            },
            "indexByName": {
              "browser_name": 2,
              "dummyrun_persona_device": 1,
              "dummyrun_persona_role": 0,
              "gen_ai_request_model": 3
            },
            "renameByName": {
              "browser_name": "Browser",
              "dummyrun_persona_device": "Device",
              "dummyrun_persona_role": "Role",
              "gen_ai_request_model": "Model"
            }
          }
        }
      ],
      "options": {
        "frameIndex": 0,
        "showHeader": true,
        "showTypeIcons": false,
        "footer": {
          "show": false,
          "reducer": null,
          "countRows": false
        },
        "cellHeight": "sm"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "inspect": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Role"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 110
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Device"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 90
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Browser"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 90
              }
            ]
          }
        ]
      }
    },
    {
      "type": "timeseries",
      "id": 7,
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (dummyrun_outcome) (increase(dummyrun_runs_total{dummyrun_target_environment=~\"$environment\", dummyrun_persona_id=~\"$persona\", dummyrun_scenario_id=~\"$scenario\"}[$__interval]))",
          "instant": false,
          "legendFormat": "{{dummyrun_outcome}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Outcomes",
      "description": "This persona's runs in each interval, stacked by outcome.",
      "transparent": false,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 9,
        "x": 0,
        "y": 5
      },
      "repeatDirection": "h",
      "maxDataPoints": 60,
      "interval": "1h",
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "min": 0,
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 80,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "completed"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "#57d273",
                  "mode": "fixed"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "blocked"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "#ff7b72",
                  "mode": "fixed"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "budget_exhausted"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "#fbad18",
                  "mode": "fixed"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "errored"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "text",
                  "mode": "fixed"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "type": "table",
      "id": 8,
      "targets": [
        {
          "expr": "sort_desc(sum by (dummyrun_finding_id, dummyrun_finding_kind, dummyrun_finding_severity, dummyrun_finding_title) (count_over_time({service_name=\"dummyrun\"} | dummyrun_finding_id != \"\" | dummyrun_target_environment=~\"$environment\" | dummyrun_persona_id=~\"$persona\" | dummyrun_finding_verdict=\"confirmed\" [$__range])))",
          "instant": true,
          "refId": "A",
          "queryType": "instant",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        }
      ],
      "title": "Findings surfaced",
      "description": "Confirmed findings from this persona in the time range, with the number of runs that hit each one.",
      "transparent": false,
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 8,
        "w": 9,
        "x": 9,
        "y": 5
      },
      "repeatDirection": "h",
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "mode": "columns"
          }
        },
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "includeByName": {
              "Value": true,
              "dummyrun_finding_id": true,
              "dummyrun_finding_kind": true,
              "dummyrun_finding_severity": true,
              "dummyrun_finding_title": true
            },
            "indexByName": {
              "Value": 2,
              "dummyrun_finding_id": 0,
              "dummyrun_finding_kind": 3,
              "dummyrun_finding_severity": 1,
              "dummyrun_finding_title": 4
            },
            "renameByName": {
              "Value": "Runs",
              "dummyrun_finding_id": "Finding",
              "dummyrun_finding_kind": "Kind",
              "dummyrun_finding_severity": "Severity",
              "dummyrun_finding_title": "Title"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "desc": true,
                "field": "Runs"
              }
            ]
          }
        }
      ],
      "options": {
        "frameIndex": 0,
        "showHeader": true,
        "showTypeIcons": false,
        "footer": {
          "show": false,
          "reducer": null,
          "countRows": false
        },
        "cellHeight": "sm"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "inspect": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Finding"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Show these findings in Explore",
                    "url": "/explore?schemaVersion=1\u0026panes=%7B%22a%22%3A%7B%22datasource%22%3A%22loki%22%2C%22queries%22%3A%5B%7B%22datasource%22%3A%7B%22type%22%3A%22loki%22%2C%22uid%22%3A%22loki%22%7D%2C%22expr%22%3A%22%7Bservice_name%3D%5C%22dummyrun%5C%22%7D+%7C+dummyrun_finding_id+%21%3D+%5C%22%5C%22+%7C+dummyrun_finding_id%3D%5C%22${__value.raw}%5C%22%22%2C%22refId%22%3A%22A%22%7D%5D%2C%22range%22%3A%7B%22from%22%3A%22${__from}%22%2C%22to%22%3A%22${__to}%22%7D%7D%7D"
                  }
                ]
              },
              {
                "id": "custom.width",
                "value": 210
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Severity"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "blocker": {
                        "color": "#ff7b72",
                        "index": 0
                      },
                      "info": {
                        "color": "text",
                        "index": 3
                      },
                      "major": {
                        "color": "#fbad18",
                        "index": 1
                      },
                      "minor": {
                        "color": "blue",
                        "index": 2
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "custom.width",
                "value": 80
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Kind"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 100
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Runs"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 60
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          }
        ]
      }
    },
    {
      "type": "bargauge",
      "id": 9,
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sort_desc(histogram_quantile(0.9, sum by (le, dummyrun_action) (increase(dummyrun_step_duration_milliseconds_bucket{dummyrun_persona_id=~\"$persona\"}[$__range]))))",
          "instant": true,
          "legendFormat": "{{dummyrun_action}}",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Slowest actions, p90",
      "description": "Step actions ranked by the duration 9 in 10 steps stay under.",
      "transparent": false,
      "datasource": {
        "type": "prometheus",
