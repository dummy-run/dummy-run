#!/bin/sh
# Mutation testing with gremlins (https://github.com/go-gremlins/gremlins).
#
# Usage: bin/mutation OUTDIR [SHARD COUNT]
#
# Each package runs on its own, with its own tests, and writes OUTDIR/<package>.json. With SHARD and COUNT, only the
# packages whose name hashes to SHARD out of COUNT run, so CI can split the work between jobs. bin/mutation-summary
# reads the files.
#
# Gremlins gives each mutant the time the package's tests took to gather coverage, times the coefficient. Unit tests
# run in milliseconds and most of a mutant's time is the build, so the coefficient is high: a lower one counts most
# mutants as timed out. The benchmark and the confidence table are left out, since their tests check measured numbers
# rather than code paths. Browser tests skip without DUMMYRUN_BROWSERS, so mutants that only they would catch count
# as lived or not covered.
set -eu
out=${1:?usage: bin/mutation OUTDIR [SHARD COUNT]}
shard=${2:-0}
count=${3:-1}
mkdir -p "$out"
root=$(pwd)
# A package gremlins runs on takes the packages under it along, so a package inside a listed one is skipped.
last=
go list -f '{{.Dir}}' ./... | sed "s|^$root/||" | sort | while read -r pkg; do
  case $pkg in internal/confidence* | internal/benchmark*) continue ;; esac
  case $pkg in "$last"/*) [ -n "$last" ] && continue ;; esac
  last=$pkg
  n=$(printf '%s' "$pkg" | cksum | cut -d' ' -f1)
  [ $((n % count)) -eq "$shard" ] || continue
  name=$(printf '%s' "$pkg" | tr '/.' '__')
  echo "gremlins: $pkg"
  ${GREMLINS:-gremlins} unleash --workers 4 --timeout-coefficient 60 --output-statuses lt \
    --exclude-files '_test\.go$' --output "$out/$name.json" "./$pkg" || echo "gremlins: $pkg did not finish"
done
